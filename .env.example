GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# LLM providers.
#
# QWEN (DashScope) is what the *live* path uses -- the backend's deep mode
# (`src/api/llm_review.py`). Groq retired `llama-3.1-8b-instant` mid-project,
# so live Groq calls now 404; Qwen replaced it. Set DASHSCOPE_API_KEY to use
# deep mode. (QWEN_API_KEY works too.)
#
# A DashScope key is only valid against the endpoint of the region the account
# was created in. The default is Beijing; for a Singapore account set
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=
# QWEN_MODEL=qwen-plus          # qwen-turbo is the cheaper tier

# GROQ is what Experiments 3 and 4 were actually measured on, and stays the
# grid default (`--provider groq`): data/llm_cache/ is keyed on
# `llama-3.1-8b-instant`, so a grid re-run replays those results from disk for
# free and reproduces Labs 3/4 exactly. A *live* Groq call needs a model id
# that still exists (`--model`), since the pinned one was retired upstream.
GROQ_API_KEY=

# GEMINI is the plan's original §5.1 choice, kept as a `--provider gemini`
# fallback; it gated real use behind billing from this account/region.
# See reports/exp3_grid_run_status.md for the full provider trail.
GEMINI_API_KEY=

# Override the live deep-mode provider without a code change: qwen | groq | gemini
# CODE_REVIEW_AI_LLM_PROVIDER=qwen
